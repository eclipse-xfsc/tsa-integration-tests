          "type": "string"
        },
        "didDocument": {
          "type": "object",
          "properties": {
            "@context": {
              "type": "array",
              "items": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ]
            },
            "authentication": {
              "type": "array",
              "items": [
                {
                  "type": "string"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "verificationMethod": {
              "type": "array",
